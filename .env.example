# Server-only secrets. Do not prefix these with VITE_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PLATFORM_ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional: set only when tenant subdomains are configured, e.g. schools.example.com.
# Leave unset to use the shared deployment URL with ?tenant=... links.
# ROOT_DOMAIN=schools.example.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Klasora <onboarding@your-verified-domain.com>
